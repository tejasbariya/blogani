<!DOCTYPE html>
<html lang="en" class="bg-zinc-50">

<head>
    <title>Create Blog</title>
    <%- include("./partials/head") %>
</head>

<body class="text-zinc-900 font-sans antialiased flex flex-col min-h-screen">
    <%- include("./partials/navbar") %>

        <main class="flex-grow flex items-center justify-center py-12">
            <div class="max-w-xl w-full mx-auto px-4 sm:px-6">
                <div class="bg-white border border-zinc-100 rounded-2xl p-6 md:p-10 space-y-6">
                    <div>
                        <h1 class="font-serif tracking-tight text-2xl text-zinc-900">Write something new</h1>
                        <p class="text-xs text-zinc-400">Draft your entry cleanly. Elements use globally managed design
                            variables.</p>
                    </div>

                    <form method="post" action="/blog/create" enctype="multipart/form-data" class="space-y-5">
                        <label for="file-upload"
                            class="flex flex-col items-center justify-center p-6 border-2 border-dashed border-zinc-200 rounded-xl bg-zinc-50/50 hover:border-zinc-300 text-center cursor-pointer transition-colors group">
                            <input id="file-upload" name="coverImage" type="file" class="sr-only">
                            <svg class="w-8 h-8 text-zinc-400 group-hover:text-accent transition-colors duration-200"
                                fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M12 16v-8m0 0l-3 3m3-3l3 3M4 17v1a2 2 0 002 2h12a2 2 0 002-2v-1" />
                            </svg>
                            <p class="mt-2 text-sm text-zinc-600">
                                <span
                                    class="font-medium text-accent group-hover:text-accent-hover transition-colors">Upload
                                    a file</span> or drag and drop
                            </p>
                            <p class="mt-1 text-xs text-zinc-400">PNG, JPG, GIF up to 10MB</p>
                        </label>

                        <div class="form-group">
                            <label class="form-label">Title</label>
                            <input type="text" name="title" placeholder="Give it a title..."
                                class="form-input font-serif text-lg">
                        </div>

                        <div class="form-group">
                            <label class="form-label">Body</label>
                            <textarea name="body" rows="8" placeholder="Start your story here..."
                                class="form-input resize-none"></textarea>
                        </div>

                        <button type="submit" class="w-full btn-primary py-3">Publish Story</button>
                    </form>
                </div>
            </div>
        </main>

        <%- include("./partials/footer") %>
</body>

</html>