<!DOCTYPE html>
<html lang="en" class="bg-zinc-50 scroll-smooth">

<head>
  <title>
    <%= locals.blog.title %>
  </title>
  <%- include("./partials/head") %>
</head>

<body class="text-zinc-900 font-sans antialiased min-h-screen flex flex-col">
  <%- include("./partials/navbar") %>

    <main class="flex-grow py-12 max-w-2xl mx-auto px-4 sm:px-6 w-full">
      <article class="space-y-8">
        <header class="space-y-3 text-center">
          <span class="text-[10px] font-bold uppercase tracking-widest text-accent">Essay</span>
          <h1 class="text-3xl md:text-4xl font-serif tracking-tight text-zinc-900 leading-tight">
            <%= locals.blog.title %>
          </h1>

          <div class="flex items-center justify-center gap-3 pt-4">
            <img src="/<%= locals.blog.postedBy.profileImageUrl %>" class="w-8 h-8 rounded-full object-cover">
            <div class="text-left leading-tight">
              <p class="text-sm font-medium text-zinc-900">
                <%= locals.blog.postedBy.fullName %>
              </p>
              <p class="text-xs text-zinc-400">
                <%= new Date(locals.blog.createdAt).toLocaleDateString('en-US', { month: 'long' , day: 'numeric' ,
                  year: 'numeric' }) %>
              </p>
            </div>
          </div>
        </header>

        <% if(locals.blog.coverImageId) { %>
          <div class="aspect-video w-full rounded-xl overflow-hidden bg-zinc-100 mt-8">
            <img src="/blog/media/<%= locals.blog.coverImageId %>" alt="" class="w-full h-full object-cover">
          </div>
          <% } %>

            <div class="max-w-prose mx-auto pt-4 border-b border-zinc-100 pb-12">
              <pre
                class="font-sans text-base leading-relaxed text-zinc-800 whitespace-pre-wrap first-letter:text-5xl first-letter:float-left first-letter:font-serif first-letter:font-medium first-letter:pr-2 first-letter:text-accent"><%= locals.blog.body %></pre>
            </div>
      </article>

      <section id="comments" class="pt-10 max-w-prose mx-auto">
        <h2 class="text-xl font-serif text-zinc-900 mb-8">Responses (<%= locals.totalComments %>)</h2>

        <% if(locals.user) { %>
          <form action="/blog/<%= blog._id %>/comment" method="POST" class="mb-12 flex gap-4">
            <img src="/<%= user.profileImageUrl %>"
              class="w-10 h-10 rounded-full object-cover border border-zinc-100 flex-shrink-0">
            <div class="flex-grow flex flex-col items-end gap-3">
              <textarea name="content" rows="3" placeholder="What are your thoughts?"
                class="form-input text-sm resize-none w-full" required></textarea>
              <button type="submit" class="btn-primary">Post Response</button>
            </div>
          </form>
          <% } else { %>
            <div class="bg-white border border-zinc-200 rounded-xl p-6 text-center mb-12 shadow-sm">
              <p class="text-sm text-zinc-600 font-medium">Join the conversation</p>
              <a href="/user/signIn" class="mt-3 inline-block btn-primary">Sign In</a>
            </div>
            <% } %>

              <div class="space-y-8">
                <% for(let comment of locals.comments) { %>
                  <div class="space-y-4">
                    <div class="flex gap-4">
                      <img src="/<%= comment.createdBy.profileImageUrl %>"
                        class="w-10 h-10 rounded-full object-cover border border-zinc-100 flex-shrink-0">
                      <div class="flex-grow space-y-1">
                        <div class="flex items-center gap-2">
                          <span class="text-sm font-medium text-zinc-900">
                            <%= comment.createdBy.fullName %>
                          </span>
                          <span class="text-xs text-zinc-400">
                            <%= new Date(comment.createdAt).toLocaleDateString() %>
                          </span>
                        </div>
                        <p class="text-sm text-zinc-700 leading-relaxed">
                          <%= comment.content %>
                        </p>

                        <div class="flex items-center gap-4 pt-1">
                          <% if(locals.user) { %>
                            <button onclick="toggleReply('<%= comment._id %>')"
                              class="text-xs font-medium text-zinc-500 hover:text-accent transition-colors">Reply</button>
                            <% if(locals.user._id.toString()===comment.createdBy._id.toString()) { %>
                              <a href="/blog/comment/delete/<%= comment._id %>"
                                class="text-xs font-medium text-red-400 hover:text-red-600 transition-colors">Delete</a>
                              <% } %>
                                <% } %>
                        </div>

                        <% if(locals.user) { %>
                          <form action="/blog/<%= blog._id %>/comment" method="POST" id="reply-form-<%= comment._id %>"
                            class="hidden mt-3 flex gap-3">
                            <input type="hidden" name="parentComment" value="<%= comment._id %>">
                            <textarea name="content" rows="1" placeholder="Write a reply..."
                              class="form-input text-sm resize-none py-2 px-3" required></textarea>
                            <button type="submit" class="btn-primary py-2 px-4 whitespace-nowrap">Reply</button>
                          </form>
                          <% } %>
                      </div>
                    </div>

                    <% if(comment.replies && comment.replies.length> 0) { %>
                      <div class="pl-14 space-y-5 border-l-2 border-zinc-100 ml-5 relative">
                        <% for(let reply of comment.replies) { %>
                          <div
                            class="flex gap-3 relative before:absolute before:content-[''] before:w-4 before:h-px before:bg-zinc-200 before:-left-1 before:top-5">
                            <img src="/<%= reply.createdBy.profileImageUrl %>"
                              class="w-8 h-8 rounded-full object-cover border border-zinc-100 flex-shrink-0 z-10">
                            <div class="flex-grow space-y-1">
                              <div class="flex items-center gap-2">
                                <span class="text-sm font-medium text-zinc-900">
                                  <%= reply.createdBy.fullName %>
                                </span>
                                <span class="text-xs text-zinc-400">
                                  <%= new Date(reply.createdAt).toLocaleDateString() %>
                                </span>
                              </div>
                              <p class="text-sm text-zinc-700">
                                <%= reply.content %>
                              </p>

                              <% if(locals.user && locals.user._id.toString()===reply.createdBy._id.toString()) { %>
                                <div class="pt-1">
                                  <a href="/blog/comment/delete/<%= reply._id %>"
                                    class="text-xs font-medium text-red-400 hover:text-red-600 transition-colors">Delete</a>
                                </div>
                                <% } %>
                            </div>
                          </div>
                          <% } %>
                      </div>
                      <% } %>
                  </div>
                  <% } %>
              </div>
      </section>
    </main>

    <%- include("./partials/footer") %>

      <script>
        function toggleReply(commentId) {
          const form = document.getElementById(`reply-form-${commentId}`);
          if (form.classList.contains('hidden')) {
            // Hide all other open reply forms first for a clean experience
            document.querySelectorAll('form[id^="reply-form-"]').forEach(f => f.classList.add('hidden'));
            form.classList.remove('hidden');
            form.querySelector('textarea').focus();
          } else {
            form.classList.add('hidden');
          }
        }
      </script>
</body>

</html>