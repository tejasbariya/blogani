# Dependency directories
node_modules/

# Environment variables (CRITICAL: Never commit the real .env file)
.env

# User Uploads (Keeps your repo lightweight and ignores dynamic content)
public/uploads/coverImages/*

# Keep the upload folder structure intact without tracking the files inside
!public/uploads/coverImages/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db